        ToggleSpeedBtn.Text = "KHÓA"
    end
end)

-- ==========================================
-- 4. LOGIC TẠO NỀN TẢNG (GRID SYSTEM)
-- ==========================================
local tileSize = 50
local renderDistance = 3
local spawnedTiles = {}

local function createTile(x, z)
    local key = x .. "," .. z
    if spawnedTiles[key] then return end
    
    local part = Instance.new("Part")
    part.Size = Vector3.new(tileSize, 1, tileSize)
    part.Position = Vector3.new(x * tileSize, 0, z * tileSize)
    part.Anchored = true
    part.Material = Enum.Material.Grass
    part.Parent = workspace
    
    spawnedTiles[key] = true
end

RunService.RenderStepped:Connect(function()
    if not _G.PlatformEnabled then return end

    local char = Player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = root.Position
            local currentX = math.floor(pos.X / tileSize)
            local currentZ = math.floor(pos.Z / tileSize)

            for x = currentX - renderDistance, currentX + renderDistance do
                for z = currentZ - renderDistance, currentZ + renderDistance do
                    createTile(x, z)
                end
            end
        end
    end
end)

PlatformBtn.MouseButton1Click:Connect(function()
    _G.PlatformEnabled = not _G.PlatformEnabled
    if _G.PlatformEnabled then
        PlatformBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
        PlatformBtn.Text = "Tạo Nền Tảng: ON"
    else
        PlatformBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
        PlatformBtn.Text = "Tạo Nền Tảng: OFF"
    end
end)

-- ==========================================
-- 5. LOGIC AUTO EAT ONLY
-- ==========================================
EatOnlyBtn.MouseButton1Click:Connect(function()
    _G.AutoEatOnly = not _G.AutoEatOnly
    if _G.AutoEatOnly then
        EatOnlyBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
        EatOnlyBtn.Text = "Auto Eat: ON"
    else
        EatOnlyBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
        EatOnlyBtn.Text = "Auto Eat: OFF"
    end
end)

local function doFastEat()
    local char = Player.Character
    local tool = char and (char:FindFirstChildOfClass("Tool") or Player.Backpack:FindFirstChildOfClass("Tool"))
    if tool then
        if tool.Parent == Player.Backpack then tool.Parent = char end
        tool:Activate()
    end
    for _ = 1, 5 do
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

task.spawn(function()
    while true do
        task.wait(0.01)
        if _G.AutoEatOnly then
            doFastEat()
        end
    end
end)
