-- Eat The World - Full Script (Auto Eat, Platform, Speed Matrix, View Data & Teleport Grab)
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Xóa GUI cũ để tránh trùng lặp
if CoreGui:FindFirstChild("UniversalSpeedGridMenu") then
    CoreGui.UniversalSpeedGridMenu:Destroy()
end

_G.AutoEatOnly = false
_G.PlatformEnabled = false

-- ==========================================
-- 1. HỆ THỐNG TELEPORT GRAB LOGIC & UI
-- ==========================================
local teleportGrabUI = nil

local function getCurrency()
    local currency = 0
    local function checkFolder(folder)
        if not folder then return nil end
        local names = {
            "Money", "Cash", "Coins", "Gold", "Currency",
            "美元", "金币", "钱", "Dollars", "Credits",
            "Points", "Tokens", "Gems"
        }
        for _, name in ipairs(names) do
            local value = folder:FindFirstChild(name)
            if value and (value:IsA("IntValue") or value:IsA("NumberValue") or value:IsA("Int64Value")) then
                return value.Value
            end
        end
        for _, value in ipairs(folder:GetChildren()) do
            if value:IsA("IntValue") or value:IsA("NumberValue") or value:IsA("Int64Value") then
                return value.Value
            end
        end
        return nil
    end

    local leaderstats = Player:FindFirstChild("leaderstats")
    currency = checkFolder(leaderstats) or 0
    if currency ~= 0 then return currency end

    local currencies = Player:FindFirstChild("Currencies")
    currency = checkFolder(currencies) or 0
    if currency ~= 0 then return currency end

    for _, child in ipairs(Player:GetChildren()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") or child:IsA("Int64Value") then
            local name = child.Name:lower()
            if name:find("money") or name:find("cash") or name:find("coin") or name:find("gold")
                or name:find("currency") or name:find("dollar") or name:find("credit")
                or name:find("point") or name:find("token") or name:find("gem") then
                return child.Value
            end
        end
    end

    for _, folderName in ipairs({"Stats", "Data", "PlayerData", "Currency"}) do
        currency = checkFolder(Player:FindFirstChild(folderName))
        if currency ~= nil then return currency end
    end
    return 0
end

local function getDistanceByCurrency(currency)
    if currency < 3000 then return 0
    elseif currency < 15000 then return 6
    elseif currency < 40000 then return 10
    elseif currency < 80000 then return 20
    elseif currency < 150000 then return 30
    elseif currency < 300000 then return 40
    elseif currency < 500000 then return 50
    elseif currency < 800000 then return 60
    elseif currency < 1200000 then return 70
    elseif currency < 2000000 then return 80
    elseif currency < 3000000 then return 90
    elseif currency < 4000000 then return 100
    elseif currency < 5500000 then return 110
    elseif currency < 6300000 then return 120
    elseif currency < 8000000 then return 130
    else return 210 end
end

local function grabForwardObject()
    local character = Player.Character
    if not character then return end
    local events = character:FindFirstChild("Events")
    if not events then return end
    local grabEvent = events:FindFirstChild("Grab")
    if not grabEvent then return end
    grabEvent:FireServer(false, false, true)
end

local function CreateTeleportGrabUI()
    if teleportGrabUI then
        teleportGrabUI.Enabled = not teleportGrabUI.Enabled
        return
    end

    teleportGrabUI = Instance.new("ScreenGui")
    teleportGrabUI.Name = "PlayerTeleportTool"
    teleportGrabUI.ResetOnSpawn = false
    teleportGrabUI.Parent = CoreGui

    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, 200, 0, 300)
    main.Position = UDim2.new(0.5, -100, 0.5, -150)
    main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    main.BorderSizePixel = 0
    main.Parent = teleportGrabUI

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -40, 0, 35)
    title.Position = UDim2.new(0, 10, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "Teleport Grab"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.TextSize = 18
    title.Font = Enum.Font.SourceSansBold
    title.Parent = main

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 30, 0, 30)
    close.Position = UDim2.new(1, -35, 0, 3)
    close.BackgroundTransparency = 1
    close.Text = "X"
    close.TextColor3 = Color3.new(1, 1, 1)
    close.TextSize = 18
    close.Parent = main

    close.MouseButton1Click:Connect(function()
        teleportGrabUI.Enabled = false
    end)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -20, 1, -50)
    scroll.Position = UDim2.new(0, 10, 0, 40)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 5
    scroll.Parent = main

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 5)
    layout.Parent = scroll

    local function refresh()
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= Player then
                local button = Instance.new("TextButton")
                button.Size = UDim2.new(1, -5, 0, 32)
                button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                button.TextColor3 = Color3.new(1, 1, 1)
                button.Text = targetPlayer.Name
                button.TextSize = 14
                button.Font = Enum.Font.SourceSans
                button.Parent = scroll

                local buttonCorner = Instance.new("UICorner")
                buttonCorner.CornerRadius = UDim.new(0, 5)
                buttonCorner.Parent = button

                button.MouseButton1Click:Connect(function()
                    local character = Player.Character
                    local targetCharacter = targetPlayer.Character

                    if not character or not targetCharacter then return end

                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    local root = character:FindFirstChild("HumanoidRootPart")
                    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

                    if not humanoid or humanoid.Health <= 0 or not root or not targetRoot then return end

                    grabForwardObject()
                    task.wait(0.2)

                    local distance = getDistanceByCurrency(getCurrency())
                    local behindPosition = targetRoot.Position - targetRoot.CFrame.LookVector * distance
                    root.CFrame = CFrame.new(behindPosition, targetRoot.Position)
                end)
            end
        end

        task.wait()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 5)
    end

    Players.PlayerAdded:Connect(refresh)
    Players.PlayerRemoving:Connect(refresh)
    refresh()

    local dragging = false
    local dragStart, startPosition

    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

-- ==========================================
-- 2. HỆ THỐNG VIEW DATA LOGIC (F9 CONSOLE)
-- ==========================================
local localization = { MaxSize = "MaxSize", Speed = "Speed", Multiplier = "Multiplier", EatSpeed = "EatSpeed" }
local function sizeGrowth(level) return math.floor(((level + 0.5) ^ 2 - 0.25) / 2 * 100) end
local function speedGrowth(level) return math.floor(level * 2 + 10) end
local function multiplierGrowth(level) return math.floor(level) end
local function eatSpeedGrowth(level) return math.floor((1 + (level - 1) * 0.2) * 10) / 10 end

local function sizePrice(level) return math.floor(level ^ 3 / 2) * 20 end
local function speedPrice(level) return math.floor((level * 3) ^ 3 / 200) * 1000 end
local function multiplierPrice(level) return math.floor((level * 10) ^ 3 / 200) * 1000 end
local function eatSpeedPrice(level) return math.floor((level * 10) ^ 3 / 200) * 2000 end

local growthFunctions = { MaxSize = sizeGrowth, Speed = speedGrowth, Multiplier = multiplierGrowth, EatSpeed = eatSpeedGrowth }
local priceFunctions = { MaxSize = sizePrice, Speed = speedPrice, Multiplier = multiplierPrice, EatSpeed = eatSpeedPrice }

local function showPlayerData()
    print("=======================================")
    print("Viewing player data")
    print("=======================================")

    for _, p in ipairs(Players:GetPlayers()) do
        print("\nPlayer: " .. p.Name)
        print("=======================================")
        local hasUpgrades = false
        local upgrades = p:FindFirstChild("Upgrades")
        if upgrades then
            for _, upg in ipairs(upgrades:GetChildren()) do
                local gFunc = growthFunctions[upg.Name]
                local pFunc = priceFunctions[upg.Name]
                if gFunc and pFunc and tonumber(upg.Value) then
                    hasUpgrades = true
                    local level = tonumber(upg.Value)
                    local cost = 0
                    for l = 2, level do cost += pFunc(l) end
                    print("  " .. localization[upg.Name] .. ": " .. level .. " level; " .. gFunc(level) .. " value; " .. cost .. " cost")
                else
                    hasUpgrades = true
                    print("  " .. upg.Name .. ": " .. tostring(upg.Value))
                end
            end
        end
        if not hasUpgrades then print("  No upgrade data available at the moment") end
    end
    print("=======================================")
    print("Data viewing completed")
    print("=======================================")

    pcall(function()
        game:GetService("StarterGui"):SetCore("DevConsoleVisible", true)
    end)
end

