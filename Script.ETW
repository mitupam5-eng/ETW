-- Eat The World - Simplified Auto Eat, Platform, Speed & View Data (Console)
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")

-- Xóa GUI cũ để tránh trùng lặp
if CoreGui:FindFirstChild("UniversalSpeedGridMenu") then
    CoreGui.UniversalSpeedGridMenu:Destroy()
end

_G.AutoEatOnly = false
_G.PlatformEnabled = false

-- ==========================================
-- HỆ THỐNG VIEW DATA LOGIC (IN VÀO F9 CONSOLE)
-- ==========================================
local localization = {
    MaxSize = "MaxSize",
    Speed = "Speed",
    Multiplier = "Multiplier",
    EatSpeed = "EatSpeed",
}

local function sizeGrowth(level) return math.floor(((level + 0.5) ^ 2 - 0.25) / 2 * 100) end
local function speedGrowth(level) return math.floor(level * 2 + 10) end
local function multiplierGrowth(level) return math.floor(level) end
local function eatSpeedGrowth(level) return math.floor((1 + (level - 1) * 0.2) * 10) / 10 end

local function sizePrice(level) return math.floor(level ^ 3 / 2) * 20 end
local function speedPrice(level) return math.floor((level * 3) ^ 3 / 200) * 1000 end
local function multiplierPrice(level) return math.floor((level * 10) ^ 3 / 200) * 1000 end
local function eatSpeedPrice(level) return math.floor((level * 10) ^ 3 / 200) * 2000 end

local growthFunctions = { MaxSize = sizeGrowth, Speed = speedGrowth, Multiplier = multiplierGrowth, EatSpeed = eatSpeedGrowth }
local priceFunctions = { MaxSize = sizePrice, Speed = speedPrice, Multiplier = multiplierPrice, EatSpeed = eatSpeedPrice }

local function showPlayerData()
    print("=======================================")
    print("Viewing player data")
    print("=======================================")

    for _, player in ipairs(Players:GetPlayers()) do
        print("")
        print("Player: " .. player.Name)
        print("=======================================")

        local hasUpgrades = false
        local upgrades = player:FindFirstChild("Upgrades")

        if upgrades then
            for _, upg in ipairs(upgrades:GetChildren()) do
                local growthFunction = growthFunctions[upg.Name]
                local priceFunction = priceFunctions[upg.Name]

                if growthFunction and priceFunction and tonumber(upg.Value) then
                    hasUpgrades = true
                    local level = tonumber(upg.Value)
                    local cost = 0

                    for l = 2, level do cost += priceFunction(l) end

                    local content =
                        "  " ..
                        localization[upg.Name] ..
                        ": " ..
                        level ..
                        " level; " ..
                        growthFunction(level) ..
                        " value; " ..
                        cost ..
                        " cost"

                    print(content)
                else
                    hasUpgrades = true
                    print("  " .. upg.Name .. ": " .. tostring(upg.Value))
                end
            end
        end

        if not hasUpgrades then
            print("  No upgrade data available at the moment")
        end
    end

    print("=======================================")
    print("Data viewing completed")
    print("=======================================")

    pcall(function()
        game:GetService("StarterGui"):SetCore("DevConsoleVisible", true)
    end)
end

