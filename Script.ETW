-- Eat The World - Loadstring Optimized Version
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")

-- Xóa GUI cũ để tránh trùng lặp khi re-execute loadstring
if CoreGui:FindFirstChild("UniversalSpeedGridMenu") then
    CoreGui.UniversalSpeedGridMenu:Destroy()
end

_G.AutoEatOnly = false
_G.AutoFarm = false
_G.PlatformEnabled = false
_G.CurrentState = "EATING"

local FORCED_TIME = 210
local stateStartTime = tick()

-- 1. TẠO KHUNG CHÍNH UI (MAIN MENU)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "UniversalSpeedGridMenu"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
