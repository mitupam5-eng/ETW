TitleBar.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
TitleBar.Text = "   ETW - ULTIMATE FARM"
TitleBar.TextColor3 = Color3.fromRGB(255, 255, 255)
TitleBar.TextXAlignment = Enum.TextXAlignment.Left
TitleBar.Font = Enum.Font.SourceSansBold
TitleBar.TextSize = 14
TitleBar.BorderSizePixel = 0
TitleBar.Parent = MainFrame

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = TitleBar

local MinBtn = Instance.new("TextButton")
MinBtn.Size = UDim2.new(0, 35, 0, 35)
MinBtn.Position = UDim2.new(1, -35, 0, 0)
MinBtn.BackgroundTransparency = 1
MinBtn.Text = "−"
MinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
MinBtn.TextSize = 22
MinBtn.Font = Enum.Font.SourceSansBold
MinBtn.Parent = MainFrame

local ContentFrame = Instance.new("Frame")
ContentFrame.Size = UDim2.new(1, -16, 1, -45)
ContentFrame.Position = UDim2.new(0, 8, 0, 40)
ContentFrame.BackgroundTransparency = 1
ContentFrame.Parent = MainFrame

local function createMainBtn(text, pos, bgClr)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Position = pos
    btn.BackgroundColor3 = bgClr
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = ContentFrame
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    return btn
end

local EatOnlyBtn = createMainBtn("Auto Eat: OFF", UDim2.new(0, 0, 0, 0), Color3.fromRGB(150, 40, 40))
local FarmBtn = createMainBtn("Auto Farm: OFF", UDim2.new(0, 0, 0, 42), Color3.fromRGB(150, 40, 40))
local PlatformBtn = createMainBtn("Tạo Nền Tảng: OFF", UDim2.new(0, 0, 0, 84), Color3.fromRGB(150, 40, 40))
local SpeedTogglePopBtn = createMainBtn("⚡ SPEED MENU (MỞ/ĐÓNG)", UDim2.new(0, 0, 0, 126), Color3.fromRGB(40, 100, 160))

local isMainMinimized = false
MinBtn.MouseButton1Click:Connect(function()
    isMainMinimized = not isMainMinimized
    if isMainMinimized then
        ContentFrame.Visible = false
        MainFrame:TweenSize(UDim2.new(0, 260, 0, 35), "Out", "Quad", 0.15, true)
        MinBtn.Text = "+"
    else
        MainFrame:TweenSize(UDim2.new(0, 260, 0, 230), "Out", "Quad", 0.15, true)
        task.wait(0.15)
        ContentFrame.Visible = true
        MinBtn.Text = "−"
    end
end)

